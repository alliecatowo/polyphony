[Unit]
Description=Polyphony Patches orchestrator
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/develop/polyphony/elixir
Environment=POLYPHONY_DIRECT=1
ExecStart=%h/develop/polyphony/scripts/launch-patches.sh
Restart=always
RestartSec=5s
CPUQuota=800%
MemoryMax=10240M
TasksMax=2048
LimitNOFILE=16384
OOMPolicy=kill
KillMode=control-group

[Install]
WantedBy=default.target
